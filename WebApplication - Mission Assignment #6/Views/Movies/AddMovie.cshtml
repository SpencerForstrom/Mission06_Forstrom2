@model WebApplication___Mission_Assignment__6.Models.Movie

<h2 class="text-center">Add a Movie</h2>

<form method="post" asp-controller="Movies" asp-action="SaveMovie" class="container">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Title:</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Year:</label>
        <input asp-for="Year" type="number" class="form-control" required />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Edited" class="form-check-input" type="checkbox" required />
        <label class="form-check-label">Edited</label>
        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Director:</label>
        <input asp-for="Director" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Rating:</label>
        <select asp-for="Rating" class="form-select">
            <option value="">Select a rating</option>
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Lent To:</label>
        <input asp-for="LentTo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Notes:</label>
        <input asp-for="Notes" class="form-control" maxlength="25" />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Movie</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
